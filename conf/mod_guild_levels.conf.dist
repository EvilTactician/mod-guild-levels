[worldserver]

########################################
# mod-guild-levels
########################################
#
#    GuildLevels.Enable
#        Description: Guild levels, guild XP and the guild perks. Off: no XP, no perks, and the
#                     perk spells are unlearned the next time a player's perks are checked.
#        Default:     1
#
#    GuildLevels.Announce
#        Description: Tell the guild when it reaches a new level, and which perk it got.
#        Default:     1

GuildLevels.Enable = 1
GuildLevels.Announce = 1

#
#    GuildLevels.XP.CurveScale
#        Description: Guild XP needed per level is Cataclysm's (16.58 million for level 2 up to
#                     54.73 million for level 25, 855.69 million in all) times this. The default
#                     0.0125 makes level 25 about 10.7 million: about three months for three to
#                     five active players.
#        Default:     0.0125
#
#    GuildLevels.XP.QuestShare
#        Description: Share of a quest's XP that also goes to the guild (Cataclysm: 0.25). Counts
#                     at the level cap too, where the quest pays money instead.
#        Default:     0.25
#
#    GuildLevels.XP.BossDungeon
#    GuildLevels.XP.BossRaid
#        Description: Guild XP for a dungeon or raid boss killed by a guild group. A 5-player
#                     dungeon pays 50% with 3 guild members, 100% with 4 and 125% with 5. Bosses
#                     gray to the highest-level guild member pay nothing, and an encounter with
#                     several bosses (a council) pays once.
#        Default:     2000, 6000
#
#    GuildLevels.XP.HeroicBonus
#        Description: Multiplier for heroic dungeons and raids.
#        Default:     1.5
#
#    GuildLevels.XP.RaidGuildMembers
#        Description: Guild members a raid needs to count as a guild group (at most 80% of the
#                     raid's size, so 8 in a 10-player raid). Cataclysm used 10 for old raids.
#        Default:     10
#
#    GuildLevels.XP.DailyCap
#        Description: Most guild XP a guild can earn in a day (server time). 0 = no cap.
#        Default:     150000
#
#    GuildLevels.XP.DailyCapUntilLevel
#        Description: The daily cap stops applying once the guild reaches this level
#                     (Cataclysm 4.2: 20).
#        Default:     20
#
#    GuildLevels.XP.BotGuildsEarn
#        Description: Only real players earn guild XP; bots in the guild only count toward the
#                     size of a guild group. 1 lets bots earn XP too, so playerbots' own guilds
#                     level up.
#        Default:     0
#
#    GuildLevels.XP.TabardKill
#        Description: Guild XP for each creature kill that rewards a living member wearing the
#                     stock Guild Tabard (5976). A flat amount: no realm rate changes it, and it
#                     counts toward the daily cap. Creatures gray to the member, critters, totems,
#                     pets and creatures that give no XP pay nothing. 0 = off.
#        Default:     10

GuildLevels.XP.CurveScale = 0.0125
GuildLevels.XP.QuestShare = 0.25
GuildLevels.XP.BossDungeon = 2000
GuildLevels.XP.BossRaid = 6000
GuildLevels.XP.HeroicBonus = 1.5
GuildLevels.XP.RaidGuildMembers = 10
GuildLevels.XP.DailyCap = 150000
GuildLevels.XP.DailyCapUntilLevel = 20
GuildLevels.XP.BotGuildsEarn = 0
GuildLevels.XP.TabardKill = 10

#
#    Perks. Percentages unless the name says otherwise; the guild level each one comes with is
#    in brackets. A perk with two ranks has a setting for each: rank 2 replaces rank 1 (the
#    two don't add up).
#
#    GuildLevels.Perk.GoodStanding1 / GoodStanding2 (2 / 12)
#        Description: More reputation from kills and quests.                 Default: 5 / 10
#    GuildLevels.Perk.Haggler1 / Haggler2 (3 / 10)
#        Description: Lower prices and repairs at vendors.                   Default: 5 / 10
#    GuildLevels.Perk.BattlefieldRenown1 / BattlefieldRenown2 (4 / 14)
#        Description: More honor from honorable kills.                       Default: 5 / 10
#    GuildLevels.Perk.SwiftSteeds1 / SwiftSteeds2 (5 / 24)
#        Description: Mounted and flying speed. Not in battlegrounds/arenas.  Default: 10 / 20
#    GuildLevels.Perk.LoyalFollowing1 / LoyalFollowing2 (6 / 18)
#        Description: More guild XP for the guild, from every source. Members'
#                     own XP doesn't change. It counts toward the daily cap.  Default: 10 / 20
#    GuildLevels.Perk.GuildTithe1 / GuildTithe2 (7 / 16)
#        Description: Extra share of looted money paid into the guild bank.  Default: 5 / 10
#    GuildLevels.Perk.FieldMedicine1 / FieldMedicine2 (8 / 21)
#        Description: Healing potions and healthstones heal more.            Default: 25 / 50
#    GuildLevels.Perk.ReinforcedGear1 / ReinforcedGear2 (9 / 17)
#        Description: Less durability lost by dying.                         Default: 10 / 20
#    Guild Vault (11) has no settings.
#    GuildLevels.Perk.BountifulHarvest1 / BountifulHarvest2 (13 / 22)
#        Description: Chance of an extra material from Mining, Herbalism,
#                     Skinning and Disenchanting.                            Default: 10 / 20
#    GuildLevels.Perk.SecondWindSpeed / SecondWindRes (15)
#        Description: Ghost run speed, and health and mana when a guild
#                     member of your group resurrects you.                   Default: 100 / 50
#    GuildLevels.Perk.LastingProvisions1 / LastingProvisions2 (19 / 23)
#        Description: Well Fed, flask and elixir buffs last longer.          Default: 50 / 100
#    GuildLevels.Perk.AlchemistsBountyChance (20)
#        Description: Chance of an extra flask or elixir when you make one.  Default: 50
#    GuildLevels.Perk.MassResurrectionHealth / MassResurrectionMinutes (25)
#        Description: Health and mana Mass Resurrection gives back, and how
#                     often one player can be raised by it. The spell's
#                     tooltip in the client patch says 35% and 10 min.      Default: 35 / 10

GuildLevels.Perk.GoodStanding1 = 5
GuildLevels.Perk.GoodStanding2 = 10
GuildLevels.Perk.Haggler1 = 5
GuildLevels.Perk.Haggler2 = 10
GuildLevels.Perk.BattlefieldRenown1 = 5
GuildLevels.Perk.BattlefieldRenown2 = 10
GuildLevels.Perk.SwiftSteeds1 = 10
GuildLevels.Perk.SwiftSteeds2 = 20
GuildLevels.Perk.LoyalFollowing1 = 10
GuildLevels.Perk.LoyalFollowing2 = 20
GuildLevels.Perk.GuildTithe1 = 5
GuildLevels.Perk.GuildTithe2 = 10
GuildLevels.Perk.FieldMedicine1 = 25
GuildLevels.Perk.FieldMedicine2 = 50
GuildLevels.Perk.ReinforcedGear1 = 10
GuildLevels.Perk.ReinforcedGear2 = 20
GuildLevels.Perk.BountifulHarvest1 = 10
GuildLevels.Perk.BountifulHarvest2 = 20
GuildLevels.Perk.SecondWindSpeed = 100
GuildLevels.Perk.SecondWindRes = 50
GuildLevels.Perk.LastingProvisions1 = 50
GuildLevels.Perk.LastingProvisions2 = 100
GuildLevels.Perk.AlchemistsBountyChance = 50
GuildLevels.Perk.MassResurrectionHealth = 35
GuildLevels.Perk.MassResurrectionMinutes = 10

########################################
# Guild news
########################################
#
#    GuildLevels.News.Enable
#        Description: Keep a guild news feed for the guild window: guild levels, bosses killed
#                     by a guild group, members' epic loot and crafts, and achievements.
#        Default:     1
#
#    GuildLevels.News.Keep
#        Description: News items kept per guild (10-500); older ones are deleted.
#        Default:     100
#
#    GuildLevels.News.ItemQuality
#        Description: Lowest item quality that makes the news (3 rare, 4 epic, 5 legendary).
#        Default:     4
#
#    GuildLevels.News.Bots
#        Description: Bots in the guild make the news with their loot and achievements too.
#        Default:     0

GuildLevels.News.Enable = 1
GuildLevels.News.Keep = 100
GuildLevels.News.ItemQuality = 4
GuildLevels.News.Bots = 0
